# Local tooling
.venv/
.playwright-mcp/
.idea/
.DS_Store
__pycache__/

# Large, re-downloadable originals. Every PDF has an extracted .txt next to it,
# and scripts/boardbook_scrape.py re-fetches them. (One PDF is over GitHub's 100 MB limit.)
*.pdf
*.png
transcripts/raw_vtt/

# Raw captured web pages. The cleaned .txt/.md versions are kept.
*.html
news/raw/fetch/

# ORESTAR exports include individual donors' home addresses.
# SUMMARY.md (no addresses) is kept.
board-members/_campaign_finance/*.xlsx

